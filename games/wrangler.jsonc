// WhatsUp-Spieleserver (Kritzelpost). Hochladen: im Ordner games/  ->  node ../relay/node_modules/wrangler/bin/wrangler.js deploy
// Eigener Worker, getrennt vom Briefkasten-Server: ein Fehler hier trifft nie die Nachrichten-Zustellung.
{
  "$schema": "../relay/node_modules/wrangler/config-schema.json",
  "name": "whatsup-games",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "GAMES", "class_name": "GameRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  // Öffentliche Signaturschlüssel der Spieler kommen vom Briefkasten-Server. Direkte Verbindung (Service Binding):
  // Worker desselben Kontos dürfen sich bei Cloudflare nicht über ihre workers.dev-Adressen aufrufen.
  "services": [{ "binding": "RELAY", "service": "whatsup-relay" }],
  "vars": {
    // Nur Ersatz, wenn es die direkte Verbindung nicht gibt (lokales Testen mit wrangler dev)
    "RELAY_URL": "https://whatsup-relay.whatsup-relay.workers.dev"
  }
}
